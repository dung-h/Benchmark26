# Copy to paths.env and replace the placeholders before sourcing.
# Paths point to user-provided inputs and environments; this file does not download them.
export B26_ARTIFACTS=/absolute/path/to/study-bundle/artifacts
export B26_MALI_SOURCE=/absolute/path/to/mali-checkout
export B26_MALI_QASM=/absolute/path/to/mali-checkout/data/quantum_circuits
export B26_QONDUCTOR_SOURCE=/absolute/path/to/qonductor-checkout
export B26_QONDUCTOR_ARCHIVE=/absolute/path/to/circuits.zip
export B26_QONDUCTOR_DATABASE=/absolute/path/to/quantum_scheduler.db
export B26_CPU_PYTHON=/absolute/path/to/cpu-environment/bin/python
export B26_GPU_PYTHON=/absolute/path/to/gpu-environment/bin/python
