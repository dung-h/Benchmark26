# Copy to paths.env, replace the placeholders, then `source configs/paths.env`.
# Variables left unset fall back to the defaults in benchmark26/paths.py.
export B26_ARTIFACTS=/absolute/path/to/study-bundle/artifacts
export B26_COHORT_PLAN=/absolute/path/to/study-bundle/cohort_plan
export B26_MALI_SOURCE=/absolute/path/to/Quantum-Execution-Time-Prediction
export B26_QONDUCTOR_SOURCE=/absolute/path/to/Qonductor-SC25
# Optional overrides
# export B26_MALI_QASM=$B26_MALI_SOURCE/data/quantum_circuits
# export B26_QONDUCTOR_ARCHIVE=$B26_QONDUCTOR_SOURCE/data/database/circuits.zip
# export B26_QONDUCTOR_DATABASE=$B26_QONDUCTOR_SOURCE/data/database/quantum_scheduler.db
# export B26_WORK=/absolute/path/to/new/outputs
# New fitting run with this code (see docs/REPRODUCTION.md)
# export B26_RUN_DIR=/absolute/path/to/new/run
# export B26_NEURAL_PYTHON=/absolute/path/to/gpu-environment/bin/python
